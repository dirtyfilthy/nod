{"id": "npm_publish", "tool": "run_shell", "arguments": {"command": "npm publish --access public"}, "expect": "ask"}
{"id": "migrate", "tool": "run_shell", "arguments": {"command": "python manage.py migrate"}, "expect": "ask"}
{"id": "docker_prune", "tool": "run_shell", "arguments": {"command": "docker system prune -af --volumes"}, "expect": "ask"}
