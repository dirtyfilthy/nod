# Copy to /etc/nod/nod.env (chmod 600, owned by the nod user) and fill in.
# These are the only secrets nod needs on the box.

# The rented brain's API key.
OPENROUTER_API_KEY=sk-or-...

# Bearer token clients must send as "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
NOD_API_TOKEN=change-me
